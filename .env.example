# --- LLM: Vultr Serverless Inference (OpenAI-compatible) ---
# Create the key in the Vultr console (Products -> Serverless Inference),
# then list models:  curl https://api.vultrinference.com/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- App ---
PORT=8080
SANDBOX_IMAGE=khaan/sandbox:1
